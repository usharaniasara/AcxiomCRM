@model Activity
@{
    ViewData["Title"] = "Activity Details";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.Subject</h1>
        <small class="text-muted">Type: @Model.ActivityType | Date: @Model.ActivityDate.ToString("yyyy-MM-dd HH:mm")</small>
    </div>
    <div>
        <a class="btn btn-outline-primary me-1" asp-action="Edit" asp-route-id="@Model.ActivityId">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to List</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card p-3 mb-3">
            <h5 class="card-title mb-3">Activity Information</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">Activity Type</dt>
                <dd class="col-sm-8"><span class="badge text-bg-secondary">@Model.ActivityType</span></dd>

                <dt class="col-sm-4">Subject</dt>
                <dd class="col-sm-8"><strong>@Model.Subject</strong></dd>

                <dt class="col-sm-4">Date & Time</dt>
                <dd class="col-sm-8">@Model.ActivityDate.ToString("F")</dd>

                <dt class="col-sm-4">Related Customer</dt>
                <dd class="col-sm-8">@(Model.Customer?.CustomerName ?? "None")</dd>

                <dt class="col-sm-4">Related Lead</dt>
                <dd class="col-sm-8">@(Model.Lead?.LeadName ?? "None")</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @if (Model.Status == "Planned") { <span class="badge text-bg-primary">Planned</span> }
                    else if (Model.Status == "Completed") { <span class="badge text-bg-success">Completed</span> }
                    else { <span class="badge text-bg-secondary">Cancelled</span> }
                </dd>

                <dt class="col-sm-4">Assigned To</dt>
                <dd class="col-sm-8">@(Model.AssignedTo?.FullName ?? "Unassigned")</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
            </dl>
        </div>

        <div class="card p-3">
            <h5 class="card-title mb-3">Change Status</h5>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var status in CrmLists.ActivityStatuses)
                {
                    if (status != Model.Status)
                    {
                        <form asp-action="ChangeStatus" asp-route-id="@Model.ActivityId" method="post" class="d-inline">
                            <input type="hidden" name="newStatus" value="@status" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Mark as @status</button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 border-danger">
            <h5 class="card-title text-danger">Delete Activity</h5>
            <p class="small text-muted">Delete this activity entry.</p>
            <form asp-action="Delete" asp-route-id="@Model.ActivityId" method="post">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this activity?');">Delete Activity</button>
            </form>
        </div>
    </div>
</div>
