@model PagedResult<Activity>
@{
    ViewData["Title"] = "Activities";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Activities</h1>
    <a class="btn btn-primary" asp-action="Create">New Activity</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Subject or description..." />
    </div>
    <div class="col-md-2">
        <select name="type" class="form-select">
            <option value="">All Types</option>
            @foreach (var t in CrmLists.ActivityTypes)
            {
                if (Model.ExtraFilter == t)
                {
                    <option value="@t" selected>@t</option>
                }
                else
                {
                    <option value="@t">@t</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            @foreach (var s in CrmLists.ActivityStatuses)
            {
                if (Model.Status == s)
                {
                    <option value="@s" selected>@s</option>
                }
                else
                {
                    <option value="@s">@s</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Date & Time</th>
            <th>Type</th>
            <th>Subject</th>
            <th>Related Entity</th>
            <th>Status</th>
            <th>Assigned To</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ActivityDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td><span class="badge text-bg-secondary">@item.ActivityType</span></td>
                <td><strong>@item.Subject</strong></td>
                <td>
                    @if (item.Customer != null)
                    {
                        <small class="text-muted">Customer:</small> <span>@item.Customer.CustomerName</span>
                    }
                    else if (item.Lead != null)
                    {
                        <small class="text-muted">Lead:</small> <span>@item.Lead.LeadName</span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>
                    @if (item.Status == "Planned") { <span class="badge text-bg-primary">Planned</span> }
                    else if (item.Status == "Completed") { <span class="badge text-bg-success">Completed</span> }
                    else { <span class="badge text-bg-secondary">Cancelled</span> }
                </td>
                <td>@(item.AssignedTo?.FullName ?? "Unassigned")</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.ActivityId">View</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.ActivityId">Edit</a>
                    <form asp-action="Delete" asp-route-id="@item.ActivityId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this activity?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager", (Model.Page, Model.TotalPages, "Index"))
