@model PagedResult<AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
    string userId = ViewBag.UserId ?? "";
    string entityName = ViewBag.EntityName ?? "";
    string actionName = ViewBag.ActionName ?? "";
    string startDate = ViewBag.StartDate ?? "";
    string endDate = ViewBag.EndDate ?? "";
}
<h1 class="h3 mb-3">Audit Logs</h1>
<p class="text-muted">Centralized security & data change auditing log. Append-only system audit trail.</p>

<form method="get" class="card p-3 mb-3">
    <div class="row g-2">
        <div class="col-md-2">
            <label class="form-label small">User ID / Name</label>
            <input name="userId" value="@userId" class="form-control form-control-sm" placeholder="User email or ID" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Entity / Module</label>
            <input name="entityName" value="@entityName" class="form-control form-control-sm" placeholder="Customer, Lead, User..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Action</label>
            <input name="action" value="@actionName" class="form-control form-control-sm" placeholder="Create, Update, Delete..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Start Date</label>
            <input type="date" name="startDate" value="@startDate" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">End Date</label>
            <input type="date" name="endDate" value="@endDate" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-sm btn-primary w-100">Filter Audit Logs</button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover bg-white align-middle small">
    <thead>
        <tr>
            <th>Timestamp (UTC)</th>
            <th>User</th>
            <th>Action</th>
            <th>Entity</th>
            <th>Record ID</th>
            <th>IP Address</th>
            <th>Changes / Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model.Items)
        {
            <tr>
                <td>@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td><strong>@(string.IsNullOrWhiteSpace(log.UserName) ? log.UserId : log.UserName)</strong></td>
                <td>
                    @if (log.Action.Contains("Create")) { <span class="badge text-bg-success">@log.Action</span> }
                    else if (log.Action.Contains("Update")) { <span class="badge text-bg-info">@log.Action</span> }
                    else if (log.Action.Contains("Delete") || log.Action.Contains("Deactivate")) { <span class="badge text-bg-danger">@log.Action</span> }
                    else if (log.Action.Contains("Login") || log.Action.Contains("Lockout")) { <span class="badge text-bg-warning text-dark">@log.Action</span> }
                    else { <span class="badge text-bg-secondary">@log.Action</span> }
                </td>
                <td><span class="badge text-bg-outline-dark border">@log.EntityName</span></td>
                <td><code>@log.RecordId</code></td>
                <td>@log.IpAddress</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(log.OldValue))
                    {
                        <div><small class="text-danger">Old:</small> <code class="text-wrap">@log.OldValue</code></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(log.NewValue))
                    {
                        <div><small class="text-success">New:</small> <code class="text-wrap">@log.NewValue</code></div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager", (Model.Page, Model.TotalPages, "Index"))
