@model FollowUpFormViewModel
@{
    ViewData["Title"] = "Edit Follow-Up";
}
<h1 class="h3 mb-3">Edit Follow-Up</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card p-3">
            <form asp-action="Edit" asp-route-id="@Model.FollowUpId" method="post">
                <partial name="_Form" model="Model" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update Follow-Up</button>
                    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
