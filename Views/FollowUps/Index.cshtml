@model PagedResult<FollowUp>
@{
    ViewData["Title"] = "Follow-Ups";
    bool upcomingOnly = ViewBag.UpcomingOnly ?? false;
    bool overdueOnly = ViewBag.OverdueOnly ?? false;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Follow-Ups</h1>
    <a class="btn btn-primary" asp-action="Create">New Follow-Up</a>
</div>

<form method="get" class="row g-2 mb-3 align-items-center">
    <div class="col-md-3">
        <input name="relatedSearch" value="@Model.SearchTerm" class="form-control" placeholder="Search remarks or customer..." />
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            @foreach (var s in CrmLists.FollowUpStatuses)
            {
                if (Model.Status == s)
                {
                    <option value="@s" selected>@s</option>
                }
                else
                {
                    <option value="@s">@s</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="upcomingOnly" value="true" id="upcomingOnly" @(upcomingOnly ? "checked" : "") />
            <label class="form-check-label" for="upcomingOnly">Upcoming Only</label>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="overdueOnly" value="true" id="overdueOnly" @(overdueOnly ? "checked" : "") />
            <label class="form-check-label text-danger" for="overdueOnly">Overdue Only</label>
        </div>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
    </div>
</form>

<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Date & Time</th>
            <th>Type</th>
            <th>Related Entity</th>
            <th>Remarks</th>
            <th>Status</th>
            <th>Assigned To</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            var isOverdue = item.Status == "Planned" && item.FollowUpDate < DateTime.UtcNow;
            <tr class="@(isOverdue ? "table-warning" : "")">
                <td>
                    <strong>@item.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</strong>
                    @if (isOverdue)
                    {
                        <span class="badge text-bg-danger ms-1">Overdue</span>
                    }
                </td>
                <td><span class="badge text-bg-secondary">@item.FollowUpType</span></td>
                <td>
                    @if (item.Customer != null)
                    {
                        <small class="text-muted">Customer:</small> <strong>@item.Customer.CustomerName</strong>
                    }
                    else if (item.Lead != null)
                    {
                        <small class="text-muted">Lead:</small> <strong>@item.Lead.LeadName</strong>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td class="text-truncate" style="max-width: 200px;">@item.Remarks</td>
                <td>
                    @if (item.Status == "Planned") { <span class="badge text-bg-primary">Planned</span> }
                    else if (item.Status == "Completed") { <span class="badge text-bg-success">Completed</span> }
                    else if (item.Status == "Missed") { <span class="badge text-bg-warning text-dark">Missed</span> }
                    else { <span class="badge text-bg-secondary">Cancelled</span> }
                </td>
                <td>@(item.AssignedTo?.FullName ?? "Unassigned")</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.FollowUpId">View</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.FollowUpId">Edit</a>
                    @if (item.Status == "Planned")
                    {
                        <form asp-action="Complete" asp-route-id="@item.FollowUpId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success">Complete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager", (Model.Page, Model.TotalPages, "Index"))
