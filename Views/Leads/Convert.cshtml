@model LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead";
}
<h1 class="h3 mb-3">Convert Lead</h1>
<p class="text-muted">Converting this lead will create a new <strong>Customer</strong> profile and an initial <strong>Opportunity</strong> record.</p>

<div class="row">
    <div class="col-md-6">
        <div class="card p-3">
            <form asp-action="Convert" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="LeadId" />
                
                <div class="mb-3">
                    <label class="form-label">Lead Name</label>
                    <input class="form-control" value="@Model.LeadName" disabled />
                </div>

                <div class="mb-3">
                    <label asp-for="OpportunityName" class="form-label">Opportunity Name</label>
                    <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Acme Cloud ERP Deal" />
                    <span asp-validation-for="OpportunityName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="OpportunityAmount" class="form-label">Opportunity Amount ($)</label>
                    <input asp-for="OpportunityAmount" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="OpportunityAmount" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Confirm Conversion</button>
                    <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.LeadId">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
