@model LeadFormViewModel
@{ ViewData["Title"] = "Create Lead"; }
<h1 class="h3">Create Lead</h1>
<form asp-action="Create" method="post" class="card p-3">
    <partial name="_Form" />
    <div class="mt-3"><button class="btn btn-primary">Save</button> <a class="btn btn-secondary" asp-action="Index">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
