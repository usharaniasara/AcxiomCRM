@model Lead
@{
    ViewData["Title"] = "Lead Details";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.LeadName</h1>
        <small class="text-muted">Code: @Model.LeadCode | Created: @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</small>
    </div>
    <div>
        @if (Model.Status != "Converted" && Model.Status != "Lost")
        {
            <a class="btn btn-success me-1" asp-action="Convert" asp-route-id="@Model.LeadId">Convert Lead</a>
        }
        <a class="btn btn-outline-primary me-1" asp-action="Edit" asp-route-id="@Model.LeadId">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to List</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card p-3 mb-3">
            <h5 class="card-title mb-3">Lead Information</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">Company Name</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "-" : Model.CompanyName)</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Phone</dt>
                <dd class="col-sm-8">@Model.Phone</dd>

                <dt class="col-sm-4">Source</dt>
                <dd class="col-sm-8"><span class="badge text-bg-secondary">@Model.Source</span></dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @if (Model.Status == "New") { <span class="badge text-bg-primary">New</span> }
                    else if (Model.Status == "Contacted") { <span class="badge text-bg-info">Contacted</span> }
                    else if (Model.Status == "Qualified") { <span class="badge text-bg-success">Qualified</span> }
                    else if (Model.Status == "Unqualified") { <span class="badge text-bg-warning">Unqualified</span> }
                    else if (Model.Status == "Converted") { <span class="badge text-bg-dark">Converted</span> }
                    else { <span class="badge text-bg-danger">Lost</span> }
                </dd>

                <dt class="col-sm-4">Expected Value</dt>
                <dd class="col-sm-8">@Model.ExpectedValue.ToString("C")</dd>

                <dt class="col-sm-4">Assigned To</dt>
                <dd class="col-sm-8">@(Model.AssignedTo?.FullName ?? "Unassigned")</dd>
            </dl>
        </div>

        <div class="card p-3">
            <h5 class="card-title mb-3">Workflow Actions</h5>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var status in CrmLists.LeadStatuses)
                {
                    if (status != Model.Status && status != "Converted")
                    {
                        <form asp-action="ChangeStatus" asp-route-id="@Model.LeadId" method="post" class="d-inline">
                            <input type="hidden" name="newStatus" value="@status" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Mark as @status</button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 mb-3">
            <h5 class="card-title">Related History</h5>
            <p class="text-muted small">Follow-ups: @(Model.FollowUps?.Count ?? 0)</p>
            <p class="text-muted small">Activities: @(Model.Activities?.Count ?? 0)</p>
            <p class="text-muted small">Opportunities: @(Model.Opportunities?.Count ?? 0)</p>
        </div>

        <div class="card p-3 border-danger">
            <h5 class="card-title text-danger">Delete Lead</h5>
            <p class="small text-muted">Deactivate or delete this lead record.</p>
            <form asp-action="Delete" asp-route-id="@Model.LeadId" method="post">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete/deactivate this lead?');">Delete Lead</button>
            </form>
        </div>
    </div>
</div>
