@model LeadFormViewModel
@{ ViewData["Title"] = "Edit Lead"; }
<h1 class="h3">Edit Lead @Model.LeadCode</h1>
<form asp-action="Edit" method="post" class="card p-3">
    <input type="hidden" asp-for="LeadId" />
    <input type="hidden" asp-for="LeadCode" />
    <partial name="_Form" />
    <div class="mt-3"><button class="btn btn-primary">Save</button> <a class="btn btn-secondary" asp-action="Index">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
