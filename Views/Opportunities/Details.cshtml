@model Opportunity
@{
    ViewData["Title"] = "Opportunity Details";
    decimal weighted = ViewBag.Weighted ?? 0m;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.OpportunityName</h1>
        <small class="text-muted">Created: @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</small>
    </div>
    <div>
        <a class="btn btn-outline-primary me-1" asp-action="Edit" asp-route-id="@Model.OpportunityId">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to List</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-8">
        <div class="card p-3 mb-3">
            <h5 class="card-title mb-3">Opportunity Details</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">Customer</dt>
                <dd class="col-sm-8">@(Model.Customer?.CustomerName ?? "None")</dd>

                <dt class="col-sm-4">Associated Lead</dt>
                <dd class="col-sm-8">@(Model.Lead?.LeadName ?? "None")</dd>

                <dt class="col-sm-4">Total Amount</dt>
                <dd class="col-sm-8"><span class="fs-5 fw-bold text-success">@Model.Amount.ToString("C")</span></dd>

                <dt class="col-sm-4">Stage</dt>
                <dd class="col-sm-8"><span class="badge text-bg-primary">@Model.Stage</span></dd>

                <dt class="col-sm-4">Probability</dt>
                <dd class="col-sm-8">@Model.Probability%</dd>

                <dt class="col-sm-4">Weighted Pipeline Value</dt>
                <dd class="col-sm-8"><span class="fw-bold text-info">@weighted.ToString("C")</span> <small class="text-muted">($Amount &times; Probability / 100)</small></dd>

                <dt class="col-sm-4">Expected Close Date</dt>
                <dd class="col-sm-8">@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @if (Model.Status == "Open") { <span class="badge text-bg-primary">Open</span> }
                    else if (Model.Status == "Won") { <span class="badge text-bg-success">Won</span> }
                    else { <span class="badge text-bg-danger">Lost</span> }
                </dd>

                <dt class="col-sm-4">Assigned To</dt>
                <dd class="col-sm-8">@(Model.AssignedTo?.FullName ?? "Unassigned")</dd>

                <dt class="col-sm-4">Notes</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</dd>
            </dl>
        </div>

        <div class="card p-3">
            <h5 class="card-title mb-3">Pipeline Stage Transition</h5>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var stage in CrmLists.OpportunityStages)
                {
                    if (stage != Model.Stage)
                    {
                        <form asp-action="ChangeStage" asp-route-id="@Model.OpportunityId" method="post" class="d-inline">
                            <input type="hidden" name="newStage" value="@stage" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Move to @stage</button>
                        </form>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 mb-3 border-danger">
            <h5 class="card-title text-danger">Delete Opportunity</h5>
            <p class="small text-muted">Remove or deactivate this opportunity.</p>
            <form asp-action="Delete" asp-route-id="@Model.OpportunityId" method="post">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this opportunity?');">Delete Opportunity</button>
            </form>
        </div>
    </div>
</div>
