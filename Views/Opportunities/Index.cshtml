@model PagedResult<Opportunity>
@{
    ViewData["Title"] = "Opportunities";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Opportunities</h1>
    <div>
        <a class="btn btn-outline-primary me-2" asp-action="Pipeline">Pipeline View</a>
        <a class="btn btn-primary" asp-action="Create">New Opportunity</a>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Opportunity name..." />
    </div>
    <div class="col-md-2">
        <select name="stage" class="form-select">
            <option value="">All Stages</option>
            @foreach (var stage in CrmLists.OpportunityStages)
            {
                if (Model.ExtraFilter == stage)
                {
                    <option value="@stage" selected>@stage</option>
                }
                else
                {
                    <option value="@stage">@stage</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            @foreach (var status in CrmLists.OpportunityStatuses)
            {
                if (Model.Status == status)
                {
                    <option value="@status" selected>@status</option>
                }
                else
                {
                    <option value="@status">@status</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Customer</th>
            <th>Amount</th>
            <th>Stage</th>
            <th>Probability</th>
            <th>Close Date</th>
            <th>Status</th>
            <th>Assigned To</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td><strong>@item.OpportunityName</strong></td>
                <td>@(item.Customer?.CustomerName ?? "-")</td>
                <td>@item.Amount.ToString("C")</td>
                <td><span class="badge text-bg-info">@item.Stage</span></td>
                <td>@item.Probability%</td>
                <td>@item.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (item.Status == "Open") { <span class="badge text-bg-primary">Open</span> }
                    else if (item.Status == "Won") { <span class="badge text-bg-success">Won</span> }
                    else { <span class="badge text-bg-danger">Lost</span> }
                </td>
                <td>@(item.AssignedTo?.FullName ?? "Unassigned")</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.OpportunityId">View</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.OpportunityId">Edit</a>
                    <form asp-action="Delete" asp-route-id="@item.OpportunityId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete or deactivate this opportunity?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager", (Model.Page, Model.TotalPages, "Index"))
