@model OpportunityFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="OpportunityId" />

<div class="mb-3">
    <label asp-for="OpportunityName" class="form-label">Opportunity Name *</label>
    <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise Cloud Deployment" />
    <span asp-validation-for="OpportunityName" class="text-danger"></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="CustomerId" class="form-label">Customer</label>
        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
            <option value="">-- Select Customer (Optional) --</option>
        </select>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="LeadId" class="form-label">Associated Lead</label>
        <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
            <option value="">-- Select Lead (Optional) --</option>
        </select>
        <span asp-validation-for="LeadId" class="text-danger"></span>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <label asp-for="Amount" class="form-label">Amount ($) *</label>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Stage" class="form-label">Stage *</label>
        <select asp-for="Stage" asp-items="ViewBag.Stages" class="form-select"></select>
        <span asp-validation-for="Stage" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Probability" class="form-label">Probability (%) *</label>
        <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
        <span asp-validation-for="Probability" class="text-danger"></span>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date *</label>
        <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
        <span asp-validation-for="ExpectedCloseDate" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Status" class="form-label">Status *</label>
        <select asp-for="Status" asp-items="ViewBag.Statuses" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="AssignedToUserId" class="form-label">Assigned User</label>
    @if (User.IsInRole(AppRoles.SalesExecutive))
    {
        <input type="hidden" asp-for="AssignedToUserId" />
        <input class="form-control" value="@User.Identity?.Name" disabled />
    }
    else
    {
        <select asp-for="AssignedToUserId" asp-items="ViewBag.Users" class="form-select">
            <option value="">-- Unassigned --</option>
        </select>
    }
    <span asp-validation-for="AssignedToUserId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Notes" class="form-label">Notes</label>
    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Notes" class="text-danger"></span>
</div>
