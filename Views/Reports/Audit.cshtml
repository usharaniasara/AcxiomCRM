@model ReportResultViewModel<AuditLog>
@{
    ViewData["Title"] = "Audit Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">@Model.ReportTitle</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to Reports</a>
</div>

<div class="alert alert-info">Total Audit Records: <strong>@Model.TotalCount</strong></div>

<table class="table table-striped table-hover bg-white align-middle small">
    <thead>
        <tr>
            <th>Timestamp (UTC)</th>
            <th>User</th>
            <th>Action</th>
            <th>Entity</th>
            <th>Record ID</th>
            <th>IP Address</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model.Items)
        {
            <tr>
                <td>@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td><strong>@(string.IsNullOrWhiteSpace(log.UserName) ? log.UserId : log.UserName)</strong></td>
                <td><span class="badge text-bg-secondary">@log.Action</span></td>
                <td><span class="badge text-bg-outline-dark border">@log.EntityName</span></td>
                <td><code>@log.RecordId</code></td>
                <td>@log.IpAddress</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(log.NewValue))
                    {
                        <code class="text-wrap">@log.NewValue</code>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager", (Model.Page, Model.TotalPages, "Audit"))
