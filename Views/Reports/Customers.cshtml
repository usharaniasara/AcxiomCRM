@model ReportResultViewModel<Customer>
@{
    ViewData["Title"] = "Customer Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">@Model.ReportTitle</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to Reports</a>
</div>

<form method="get" class="card p-3 mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label small">Search</label>
            <input name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control form-control-sm" placeholder="Name, email, company..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small">Status</label>
            <select name="Status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                @foreach (var s in CrmLists.CustomerStatuses)
                {
                    if (Model.Filter.Status == s) { <option value="@s" selected>@s</option> }
                    else { <option value="@s">@s</option> }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Start Date</label>
            <input type="date" name="StartDate" value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">End Date</label>
            <input type="date" name="EndDate" value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-sm btn-primary w-100">Apply Filter</button>
        </div>
    </div>
</form>

<div class="alert alert-info">Total Records Found: <strong>@Model.TotalCount</strong></div>

<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Code</th>
            <th>Customer Name</th>
            <th>Company</th>
            <th>Email</th>
            <th>Phone</th>
            <th>City / State</th>
            <th>Status</th>
            <th>Created Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Items)
        {
            <tr>
                <td>@c.CustomerCode</td>
                <td><strong>@c.CustomerName</strong></td>
                <td>@c.CompanyName</td>
                <td>@c.Email</td>
                <td>@c.Phone</td>
                <td>@c.City, @c.State</td>
                <td><span class="badge text-bg-success">@c.Status</span></td>
                <td>@c.CreatedDate.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager", (Model.Page, Model.TotalPages, "Customers"))
