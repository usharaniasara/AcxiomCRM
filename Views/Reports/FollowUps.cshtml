@model ReportResultViewModel<FollowUp>
@{
    ViewData["Title"] = "Follow-Up Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">@Model.ReportTitle</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to Reports</a>
</div>

<form method="get" class="card p-3 mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label small">Search</label>
            <input name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control form-control-sm" placeholder="Remarks or customer..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small">Status</label>
            <select name="Status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                @foreach (var s in CrmLists.FollowUpStatuses)
                {
                    if (Model.Filter.Status == s) { <option value="@s" selected>@s</option> }
                    else { <option value="@s">@s</option> }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Start Date</label>
            <input type="date" name="StartDate" value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">End Date</label>
            <input type="date" name="EndDate" value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-sm btn-primary w-100">Apply Filter</button>
        </div>
    </div>
</form>

<div class="alert alert-info">Total Follow-Ups Recorded: <strong>@Model.TotalCount</strong></div>

<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Date & Time</th>
            <th>Type</th>
            <th>Related Entity</th>
            <th>Remarks</th>
            <th>Status</th>
            <th>Assigned To</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model.Items)
        {
            <tr>
                <td>@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td><span class="badge text-bg-secondary">@f.FollowUpType</span></td>
                <td>
                    @if (f.Customer != null) { <span>Customer: @f.Customer.CustomerName</span> }
                    else if (f.Lead != null) { <span>Lead: @f.Lead.LeadName</span> }
                    else { <span>-</span> }
                </td>
                <td>@f.Remarks</td>
                <td>
                    @if (f.Status == "Completed") { <span class="badge text-bg-success">Completed</span> }
                    else if (f.Status == "Planned") { <span class="badge text-bg-primary">Planned</span> }
                    else if (f.Status == "Missed") { <span class="badge text-bg-warning text-dark">Missed</span> }
                    else { <span class="badge text-bg-secondary">Cancelled</span> }
                </td>
                <td>@(f.AssignedTo?.FullName ?? "Unassigned")</td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager", (Model.Page, Model.TotalPages, "FollowUps"))
