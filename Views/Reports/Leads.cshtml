@model ReportResultViewModel<Lead>
@{
    ViewData["Title"] = "Lead Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">@Model.ReportTitle</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to Reports</a>
</div>

<form method="get" class="card p-3 mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <label class="form-label small">Search</label>
            <input name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control form-control-sm" placeholder="Lead name or company..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small">Status</label>
            <select name="Status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                @foreach (var s in CrmLists.LeadStatuses)
                {
                    if (Model.Filter.Status == s) { <option value="@s" selected>@s</option> }
                    else { <option value="@s">@s</option> }
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Start Date</label>
            <input type="date" name="StartDate" value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">End Date</label>
            <input type="date" name="EndDate" value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-sm btn-primary w-100">Apply Filter</button>
        </div>
    </div>
</form>

<div class="alert alert-info d-flex justify-content-between">
    <span>Total Leads: <strong>@Model.TotalCount</strong></span>
    <span>Total Expected Revenue: <strong>@Model.SummaryTotalValue.ToString("C")</strong></span>
</div>

<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Code</th>
            <th>Lead Name</th>
            <th>Company</th>
            <th>Source</th>
            <th>Status</th>
            <th>Expected Value</th>
            <th>Assigned To</th>
            <th>Created Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model.Items)
        {
            <tr>
                <td>@l.LeadCode</td>
                <td><strong>@l.LeadName</strong></td>
                <td>@l.CompanyName</td>
                <td><span class="badge text-bg-secondary">@l.Source</span></td>
                <td><span class="badge text-bg-info">@l.Status</span></td>
                <td>@l.ExpectedValue.ToString("C")</td>
                <td>@(l.AssignedTo?.FullName ?? "Unassigned")</td>
                <td>@l.CreatedDate.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager", (Model.Page, Model.TotalPages, "Leads"))
