@model ReportResultViewModel<UserActivityReportItem>
@{
    ViewData["Title"] = "User Activity Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">@Model.ReportTitle</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to Reports</a>
</div>

<p class="text-muted">Breakdown of sales activity, lead ownership, follow-ups completed, and revenue won per team member.</p>

<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Team Member</th>
            <th>Role</th>
            <th>Assigned Leads</th>
            <th>Assigned Deals</th>
            <th>Follow-Ups Completed</th>
            <th>Activities Completed</th>
            <th>Won Revenue Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Items)
        {
            <tr>
                <td><strong>@user.UserName</strong></td>
                <td>
                    @if (user.Role == AppRoles.Admin) { <span class="badge text-bg-danger">Admin</span> }
                    else if (user.Role == AppRoles.Manager) { <span class="badge text-bg-primary">Manager</span> }
                    else { <span class="badge text-bg-success">SalesExecutive</span> }
                </td>
                <td>@user.AssignedLeadsCount</td>
                <td>@user.AssignedOpportunitiesCount</td>
                <td>@user.CompletedFollowUpsCount</td>
                <td>@user.CompletedActivitiesCount</td>
                <td class="fw-bold text-success">@user.WonDealsTotal.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager", (Model.Page, Model.TotalPages, "UserActivity"))
