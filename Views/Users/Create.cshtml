@model UserFormViewModel
@{
    ViewData["Title"] = "Create User";
}
<h1 class="h3 mb-3">Create User</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card p-3">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name *</label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. Jane Doe" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address *</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="jane@axciomcrm.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password *</label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <small class="text-muted">Min 8 chars, uppercase, lowercase, digit & symbol.</small>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label">Role *</label>
                    <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select"></select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="IsActive" class="form-check-label">Active Account</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create User</button>
                    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
