@model PagedResult<UserListItemViewModel>
@{
    ViewData["Title"] = "User Management";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">User Management</h1>
    <a class="btn btn-primary" asp-action="Create">Create New User</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name or email..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-striped bg-white align-middle">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Active Status</th>
            <th>Lockout Status</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Items)
        {
            <tr>
                <td><strong>@user.FullName</strong></td>
                <td>@user.Email</td>
                <td>
                    @if (user.Role == AppRoles.Admin) { <span class="badge text-bg-danger">Admin</span> }
                    else if (user.Role == AppRoles.Manager) { <span class="badge text-bg-primary">Manager</span> }
                    else if (user.Role == AppRoles.SalesExecutive) { <span class="badge text-bg-success">SalesExecutive</span> }
                    else { <span class="badge text-bg-secondary">@user.Role</span> }
                </td>
                <td>
                    @if (user.IsActive) { <span class="badge text-bg-success">Active</span> }
                    else { <span class="badge text-bg-secondary">Inactive</span> }
                </td>
                <td>
                    @if (user.IsLockedOut) { <span class="badge text-bg-danger">Locked Out</span> }
                    else { <span class="badge text-bg-light text-dark">Normal</span> }
                </td>
                <td>@user.CreatedDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@user.Id">Details</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.Id">Edit</a>
                    @if (user.IsActive)
                    {
                        <form asp-action="Deactivate" asp-route-id="@user.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning" onclick="return confirm('Deactivate user @user.Email?');">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" asp-route-id="@user.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Pager", (Model.Page, Model.TotalPages, "Index"))
