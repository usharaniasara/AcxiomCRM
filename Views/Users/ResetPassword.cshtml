@model AdminResetPasswordViewModel
@{
    ViewData["Title"] = "Admin Reset Password";
}
<h1 class="h3 mb-3">Reset Password</h1>
<p class="text-muted">Set a new password for account: <strong>@Model.Email</strong></p>

<div class="row">
    <div class="col-md-6">
        <div class="card p-3">
            <form asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Email" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password *</label>
                    <input asp-for="NewPassword" class="form-control" type="password" />
                    <small class="text-muted">Min 8 chars, uppercase, lowercase, digit & symbol.</small>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password *</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Reset Password</button>
                    <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.UserId">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
