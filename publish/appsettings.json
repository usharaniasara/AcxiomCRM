{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=acxiomcrm.db"
  },
  "App": {
    "Name": "AcxiomCRM",
    "PageSize": 10,
    "ReportPageSize": 15
  },
  "Identity": {
    "RequiredLength": 8,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
